{
  "name": "cs2-2d-demo-viewer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.0.3",
    "google-protobuf": "^3.21.2",
    "idb-keyval": "^6.2.2",
    "preact-iso": "2.8.1",
    "primereact": "^10.8.2",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "vite": "^7.1.11",
    "wait-on": "^9.0.5"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "crear:exe": "vite build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.agustin.cs2demos",
    "productName": "Demos CS2",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  }
}